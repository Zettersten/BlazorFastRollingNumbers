@namespace BlazorFastRollingNumbers

<span class="bfrn @CssClass"
      style="--roll-duration: @Duration; --roll-easing: @Easing"
      aria-label="@AriaLabel"
      aria-live="@AriaLive">
    @for (var i = 0; i < _digitCount; i++)
    {
        var item = _digitData[i];
        <span class="bfrn__digit" style="--digit-offset: @(item.Offset)%" data-digit="@i">
            <span class="bfrn__scale" aria-hidden="true">
                <span>0</span>
                <span>1</span>
                <span>2</span>
                <span>3</span>
                <span>4</span>
                <span>5</span>
                <span>6</span>
                <span>7</span>
                <span>8</span>
                <span>9</span>
                <span>-</span>
            </span>
            <span class="bfrn__value">@item.Char</span>
        </span>
    }
</span>
