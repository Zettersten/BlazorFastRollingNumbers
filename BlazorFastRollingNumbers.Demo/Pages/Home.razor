@page "/"

<PageTitle>Blazor Fast Rolling Numbers - Demo & Documentation</PageTitle>

<div class="page">
    <LandingHeader />

    <section class="playground">
        <h2>Interactive Playground</h2>
        <div class="playground-content">
            <div class="controls">
                <input type="number" @bind="_playgroundValue" @bind:event="oninput" placeholder="Enter a number" />
                <button @onclick="RandomPlayground" class="btn-random">🎲 Random</button>
            </div>
            <div class="display">
                <BlazorFastRollingNumber Value="_playgroundValue" MinimumDigits="6" CssClass="display-number" />
            </div>
        </div>
    </section>

    <section class="examples-section">
        <h2>Interactive Examples</h2>
        <p class="subtitle">Click any card to increment the value</p>
        <div class="examples-grid">
            <div class="example-card" @onclick="() => _counter++">
                <div class="card-label">Counter</div>
                <div class="card-value">
                    <BlazorFastRollingNumber Value="_counter" MinimumDigits="3" CssClass="mono" />
                </div>
                <div class="card-code">MinimumDigits="3"</div>
            </div>

            <div class="example-card" @onclick="() => _score += 100">
                <div class="card-label">Score</div>
                <div class="card-value">
                    <BlazorFastRollingNumber Value="_score" MinimumDigits="5" Duration="500ms" CssClass="mono" />
                </div>
                <div class="card-code">Duration="500ms"</div>
            </div>

            <div class="example-card" @onclick="() => _temp += 5">
                <div class="card-label">Temperature</div>
                <div class="card-value">
                    <BlazorFastRollingNumber Value="_temp" CssClass="mono" />°C
                </div>
                <div class="card-code">Negative numbers</div>
            </div>

            <div class="example-card" @onclick="() => _price += 999">
                <div class="card-label">Price</div>
                <div class="card-value">
                    $<BlazorFastRollingNumber Value="_price" MinimumDigits="5" Duration="800ms" Easing="Easing.EaseInOutCubic" CssClass="mono" />
                </div>
                <div class="card-code">Easing.EaseInOutCubic</div>
            </div>
        </div>
    </section>

    <section class="showcase-section">
        <h2>Styling Examples</h2>
        <div class="showcase-grid">
            <div class="showcase-item">
                <div class="showcase-label">Large Display</div>
                <BlazorFastRollingNumber Value="_subscribers" CssClass="large" />
                <button @onclick="() => _subscribers += 1000" class="showcase-btn">+1K Subscribers</button>
            </div>

            <div class="showcase-item">
                <div class="showcase-label">Colorful</div>
                <BlazorFastRollingNumber Value="_likes" CssClass="colorful" />
                <button @onclick="() => _likes++" class="showcase-btn">❤️ Like</button>
            </div>

            <div class="showcase-item">
                <div class="showcase-label">Compact</div>
                <BlazorFastRollingNumber Value="_views" CssClass="compact" />
                <button @onclick="() => _views += 10" class="showcase-btn">👁️ +10 Views</button>
            </div>
        </div>
    </section>

    <FeaturesSection />
    <InstallationSection />
    <SiteFooter />
</div>

